---
/** A basic floor plan: enough to locate wet areas and services, not a
 *  construction drawing. Room names go inside a room only when they fit at the
 *  drawn size; otherwise the room carries its ID and the key names it. */
interface R { id: string; x: number; y: number; w: number; h: number; label: string; kind: string; note?: string; area: number }
interface P { id: string; x: number; y: number; label: string; kind: string }
interface Props {
  floor: { extent: number[]; rooms: R[]; points: P[] };
  title: string;
}
const { floor, title } = Astro.props;
const [W, H] = floor.extent;
const f = 0.42;
const pad = 1.4;
const Y = (y: number) => H - y;
const fits = (r: R) => r.label.length * f * 0.56 < r.w - 0.3 && r.h > 1.4 * f;
const uid = `f${Math.abs([...title].reduce((a, c) => (a * 31 + c.charCodeAt(0)) | 0, 11))}`;
---

<figure class="floorplan" aria-label={title}>
  <div class="fp-svg">
    <svg viewBox={`${-pad} ${-pad} ${W + 2 * pad} ${H + 2 * pad}`} role="img" aria-labelledby={`${uid}-t`} xmlns="http://www.w3.org/2000/svg">
      <title id={`${uid}-t`}>{title}</title>
      {floor.rooms.map((r) => (
        <rect x={r.x} y={Y(r.y + r.h)} width={r.w} height={r.h} class:list={["room", `k-${r.kind}`]} />
      ))}
      <rect x="0" y="0" width={W} height={H} class="walls" />
      {floor.rooms.map((r) => fits(r) ? (
        <text x={r.x + r.w / 2} y={Y(r.y + r.h / 2)} text-anchor="middle" dominant-baseline="central" class="name" style={`font-size:${f}px`}>{r.label}</text>
      ) : (
        <text x={r.x + r.w / 2} y={Y(r.y + r.h / 2)} text-anchor="middle" dominant-baseline="central" class="rid" style={`font-size:${f}px`}>{r.id}</text>
      ))}
      {floor.points.map((p) => (
        <g class="fp-pt">
          <circle cx={p.x} cy={Y(p.y)} r="0.22" />
          <text x={p.x + (p.x <= 0 ? -0.35 : 0.35)} y={Y(p.y) + (p.x > 0 && p.x < W && p.y <= 0 ? -0.35 : 0)} text-anchor={p.x <= 0 ? "end" : "start"} dominant-baseline="central" style={`font-size:${f * 0.85}px`}>{p.id}</text>
        </g>
      ))}
      <g class="n" transform={`translate(${W + pad - 0.55} ${-pad + 0.9})`}>
        <path d="M 0 -0.7 L 0.25 0.15 L 0 -0.05 L -0.25 0.15 Z" />
        <text x="0" y="0.62" text-anchor="middle" style="font-size:0.38px">N</text>
      </g>
      <text x={W / 2} y={H + 0.95} text-anchor="middle" class="dim" style={`font-size:${f * 0.9}px`}>{W} m × {H} m</text>
    </svg>
  </div>
  <div class="fp-key">
    <table>
      <caption class="sr-caption">Rooms in {title.toLowerCase()}</caption>
      <thead><tr><th scope="col">ID</th><th scope="col">Room</th><th scope="col">Area</th></tr></thead>
      <tbody>
        {floor.rooms.map((r) => (
          <tr class:list={[{ wet: r.kind === "wet", svc: r.kind === "service" }]}>
            <th scope="row">{r.id}</th>
            <td>{r.label}{r.kind === "wet" && <span class="tag">wet area</span>}{r.kind === "service" && <span class="tag">services</span>}{r.note && <span class="note"> — {r.note}</span>}</td>
            <td class="num">{r.area.toLocaleString("en-AU", { maximumFractionDigits: 1 })} m²</td>
          </tr>
        ))}
        {floor.points.map((p) => (
          <tr><th scope="row">{p.id}</th><td>{p.label}</td><td></td></tr>
        ))}
      </tbody>
    </table>
    <p class="legend">Shaded rooms are wet areas; the darker band is services. Internal walls are indicative.</p>
  </div>
</figure>

<style>
  .floorplan {
    display: grid;
    gap: 1rem 1.5rem;
    margin: 1.5rem 0;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .floorplan {
      grid-template-columns: minmax(16rem, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    font-family: var(--at-font-body, system-ui);
  }

  .room {
    fill: var(--at-bg);
    stroke: var(--at-text-muted);
    stroke-width: 0.05;
  }

  .k-wet {
    fill: color-mix(in srgb, var(--at-primary) 24%, var(--at-bg));
  }

  .k-service {
    fill: color-mix(in srgb, var(--at-tertiary) 40%, var(--at-bg));
  }

  .walls {
    fill: none;
    stroke: var(--at-text);
    stroke-width: 0.14;
  }

  .name,
  .rid {
    fill: var(--at-text);
  }

  .rid {
    font-family: var(--at-font-mono);
    font-weight: 600;
  }

  .fp-pt circle {
    fill: var(--at-primary);
  }

  .fp-pt text,
  .dim,
  .n text {
    fill: var(--at-text-secondary);
  }

  .n path {
    fill: var(--at-text);
  }

  .fp-key {
    overflow-x: auto;
    font-size: 0.88rem;
  }

  .fp-key table {
    width: 100%;
    margin: 0;
  }

  .fp-key th[scope="row"] {
    font-family: var(--at-font-mono);
  }

  .tag {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.35rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--at-primary) 20%, var(--at-bg));
    font-size: 0.78em;
  }

  .note {
    color: var(--at-text-muted);
  }

  .num {
    white-space: nowrap;
  }

  .legend {
    margin: 0.5rem 0 0;
    color: var(--at-text-muted);
    font-size: 0.85rem;
  }

  .sr-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
