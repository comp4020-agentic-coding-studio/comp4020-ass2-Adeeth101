---
import { sites, indicators, pct } from "../lib/model";

/** The same rounding as `pct`, without the unit: the caption carries it once
 *  rather than every cell carrying it three times, which is what pushed this
 *  table past the desktop content column. */
const num = (v: number): string => pct(v).replace(' %', '');

/** Per-site band thresholds. Each cell is baseline / competent / excellent, so
 *  band 1 is below the first figure, 2 and 3 are the intervals, and 4 is at or
 *  beyond the third.
 *
 *  Sites are rows and indicators are columns, which is both how a student reads
 *  it — find your site, read across — and the orientation that fits a desktop
 *  content column. The other way round the table needed 1,208 px in an 864 px
 *  column and scrolled sideways at the desktop marking viewport.
 *
 *  Water closure and garden water satisfaction are adjacent columns and are never
 *  separated (CLAUDE.md, Scoring). */
const SHORT: Record<string, string> = {
  water_closure: "Water closure",
  garden_water_satisfaction: "Garden water satisfaction",
  food_kcal_closure: "Food energy closure",
  protein_closure: "Protein closure",
  nutrient_closure: "Nutrient closure",
};
---

<div class="scroller">
  <table>
    <caption class="sr-only">
      Reference-band thresholds as percentages: each cell gives the baseline, competent
      and excellent reference-design values for that site and indicator
    </caption>
    <thead>
      <tr>
        <th scope="col">Site</th>
        {
          indicators.map((ind) => (
            <th scope="col">
              {SHORT[ind.key] ?? ind.name}
              {ind.key === "garden_water_satisfaction" && (
                <span class="pair">always beside water closure</span>
              )}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        sites.map((s) => (
          <tr>
            <th scope="row">
              {s.short}
              <span class="sid">{s.id}</span>
            </th>
            {
              indicators.map((ind) => {
                const b = s.bands[ind.key as keyof typeof s.bands];
                return (
                  <td>
                    {num(b.baseline)}<span class="sep">/</span>{num(b.competent)}<span
                      class="sep">/</span>{num(b.excellent)}
                  </td>
                );
              })
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .scroller {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    min-width: 32rem;
    margin: 0;
  }

  th[scope="col"] {
    vertical-align: bottom;
    font-size: 0.86rem;
    line-height: 1.25;
  }

  th[scope="row"] {
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .sid {
    display: block;
    color: var(--at-text-muted);
    font-family: var(--at-font-mono);
    font-size: 0.72rem;
    font-weight: 400;
  }

  td {
    white-space: nowrap;
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .pair {
    display: block;
    color: var(--at-on-primary);
    font-size: 0.72rem;
    font-weight: 400;
    opacity: 0.8;
  }

  .sep {
    padding: 0 0.15rem;
    color: var(--at-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
