---
/** The semester as one commission: measure, hand over, design, review. Built
 *  as an HTML grid rather than an SVG so that at phone width it becomes a
 *  list instead of shrinking its labels. */
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { homeById } from "../lib/cases";
import { STAGES, courseWeeks, weekHref } from "../lib/weeks";

const assessments = await getPublishedCollection("assessments");
/** Weights and due weeks come from the assessment entries, never from a literal
 *  here, so the timeline cannot advertise a mark the assessment page contradicts. */
const capstone = assessments
  .filter((a) => a.data.week === 12)
  .sort((a, b) => b.data.weight - a.data.weight)[0];
/** The capstone has its own tile at the end, so it is not also listed in week 12. */
const assessedIn = (week: number) =>
  assessments.filter((a) => a.data.week === week && a.id !== capstone?.id);
---

<ol class="timeline" aria-label="The twelve weeks and the assessment period">
  {courseWeeks.map((entry) => (
    <li class={`wk ph-${entry.stage}`}>
      <a href={withBase(weekHref(entry.week))}>
        <span class="n">Week {entry.week}</span>
        <span class="t">{entry.topic}</span>
        <span class="m">
          {entry.lead ? `${homeById(entry.lead).short} leads` : "all five homes"}
          {assessedIn(entry.week).map((a) => ` · ${a.data.title.split(":")[0]}`)}
        </span>
      </a>
    </li>
  ))}
  <li class="wk ph-exam">
    <a href={withBase("/assessments/")}>
      <span class="n">Assessment period</span>
      <span class="t">{capstone?.data.title}</span>
      <span class="m">{capstone?.data.weight} %</span>
    </a>
  </li>
</ol>
<ul class="phases" aria-hidden="true">
  <li class="ph-learn">{STAGES.learn.label}: {STAGES.learn.span.toLowerCase()}</li>
  <li class="ph-handover">{STAGES.handover.label}: {STAGES.handover.span.toLowerCase()}</li>
  <li class="ph-design">{STAGES.design.label}: {STAGES.design.span.toLowerCase()}</li>
  <li class="ph-exam">Assessment period</li>
</ul>

<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.4rem;
    margin: 1.5rem 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .wk a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    height: 100%;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--at-border);
    border-top-width: 4px;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }

  .wk a:hover,
  .wk a:focus-visible {
    background: var(--at-bg-alt);
  }

  .n {
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
    color: var(--at-text-muted);
  }

  .t {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .m {
    margin-top: auto;
    font-size: 0.78rem;
    color: var(--at-text-secondary);
  }

  .ph-learn a,
  li.ph-learn::before {
    border-top-color: var(--at-primary);
  }

  .ph-handover a {
    border-top-color: var(--at-tertiary);
  }

  .ph-design a {
    border-top-color: var(--at-secondary);
  }

  .ph-exam a {
    border-top-color: var(--at-text);
  }

  .phases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--at-text-secondary);
  }

  .phases li::before {
    content: "";
    display: inline-block;
    width: 1.4rem;
    height: 0.3rem;
    margin-right: 0.4rem;
    vertical-align: middle;
    border-radius: 2px;
  }

  .phases .ph-learn::before {
    background: var(--at-primary);
  }

  .phases .ph-handover::before {
    background: var(--at-tertiary);
  }

  .phases .ph-design::before {
    background: var(--at-secondary);
  }

  .phases .ph-exam::before {
    background: var(--at-text);
  }

  @media (max-width: 560px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
