---
/** The semester as one commission: measure, hand over, design, review. Built
 *  as an HTML grid rather than an SVG so that at phone width it becomes a
 *  list instead of shrinking its labels. */
import { withBase } from "astro-theme-university/url";
import { TOPICS, LEAD_HOMES, homeById } from "../lib/cases";

const quiz = new Set([3, 5, 8, 10, 12]);
const phase = (w: number) => (w <= 6 ? "measure" : w === 7 ? "handover" : "design");
const weeks = Array.from({ length: 12 }, (_, i) => i + 1);
---

<ol class="timeline" aria-label="The twelve weeks and the assessment period">
  {weeks.map((w) => (
    <li class={`wk ph-${phase(w)}`}>
      <a href={withBase(`/lectures/week-${String(w).padStart(2, "0")}/`)}>
        <span class="n">Week {w}</span>
        <span class="t">{TOPICS[w]}</span>
        <span class="m">
          {LEAD_HOMES[w] ? `${homeById(LEAD_HOMES[w]!).short} leads` : "all five homes"}
          {quiz.has(w) && " · quiz"}
          {w === 7 && " · A1 due"}
        </span>
      </a>
    </li>
  ))}
  <li class="wk ph-exam">
    <a href={withBase("/assessments/")}>
      <span class="n">Exam period</span>
      <span class="t">A2 investment proposal</span>
      <span class="m">40 %</span>
    </a>
  </li>
</ol>
<ul class="phases" aria-hidden="true">
  <li class="ph-measure">Measure: weeks 1–6</li>
  <li class="ph-handover">Specialist handover: week 7</li>
  <li class="ph-design">Design: weeks 8–12</li>
  <li class="ph-exam">Proposal</li>
</ul>

<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.4rem;
    margin: 1.5rem 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .wk a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    height: 100%;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--at-border);
    border-top-width: 4px;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }

  .wk a:hover,
  .wk a:focus-visible {
    background: var(--at-bg-alt);
  }

  .n {
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
    color: var(--at-text-muted);
  }

  .t {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .m {
    margin-top: auto;
    font-size: 0.78rem;
    color: var(--at-text-secondary);
  }

  .ph-measure a,
  li.ph-measure::before {
    border-top-color: var(--at-primary);
  }

  .ph-handover a {
    border-top-color: var(--at-tertiary);
  }

  .ph-design a {
    border-top-color: var(--at-secondary);
  }

  .ph-exam a {
    border-top-color: var(--at-text);
  }

  .phases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--at-text-secondary);
  }

  .phases li::before {
    content: "";
    display: inline-block;
    width: 1.4rem;
    height: 0.3rem;
    margin-right: 0.4rem;
    vertical-align: middle;
    border-radius: 2px;
  }

  .phases .ph-measure::before {
    background: var(--at-primary);
  }

  .phases .ph-handover::before {
    background: var(--at-tertiary);
  }

  .phases .ph-design::before {
    background: var(--at-secondary);
  }

  .phases .ph-exam::before {
    background: var(--at-text);
  }

  @media (max-width: 560px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
