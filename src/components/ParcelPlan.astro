---
/** Context plans at a smaller scale: a rural home's whole parcel with its
 *  working area, or the Brisbane townhouse's strata scheme with the lot and the
 *  shared-garden allocation. Both exist to answer "where is the plan on the
 *  property, and what does the household not own?" */
interface Feature { id: string; x: number; y: number; w: number; h: number; label: string; kind: string }
interface Props {
  title: string;
  parcel?: { extent: number[]; working_area: number[]; features: Feature[]; road: string; note: string } | null;
  scheme?: {
    extent: number[]; lots: { n: number; x: number; y: number; w: number; h: number }[]; patel_lot: number;
    driveway: number[]; parking: number[]; garden: number[]; allocation: number[]; street: string; note: string;
  } | null;
}
const { title, parcel, scheme } = Astro.props;
const ext = (parcel ?? scheme)!.extent;
const [W, H] = ext;
const f = Math.max(W, H) / 38;
const pad = 3 * f;
const Y = (y: number) => H - y;
const uid = `c${Math.abs([...title].reduce((a, c) => (a * 31 + c.charCodeAt(0)) | 0, 5))}`;
const box = (r: number[]) => ({ x: r[0], y: Y(r[1] + r[3]), width: r[2], height: r[3] });
const wa = parcel?.working_area;
const scaleStep = W >= 80 ? 20 : 10;
---

<figure class="ctxplan">
  <svg viewBox={`${-pad} ${-pad} ${W + 2 * pad} ${H + 2 * pad + 2 * f}`} role="img" aria-labelledby={`${uid}-t`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${uid}-t`}>{title}</title>
    <defs>
      <pattern id={`${uid}-veg`} width={f * 1.2} height={f * 1.2} patternUnits="userSpaceOnUse">
        <circle cx={f * 0.6} cy={f * 0.6} r={f * 0.18} class="vegdot" />
      </pattern>
      <pattern id={`${uid}-h`} width={f * 0.8} height={f * 0.8} patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2={f * 0.8} class="hl" style={`stroke-width:${f * 0.08}`} />
      </pattern>
    </defs>
    <rect x="0" y="0" width={W} height={H} class="bound" style={`stroke-width:${f * 0.15}`} />

    {parcel && parcel.features.map((k) => (
      <g>
        <rect x={k.x} y={Y(k.y + k.h)} width={k.w} height={k.h}
              class={`k-${k.kind}`} fill={k.kind === "retained" ? `url(#${uid}-veg)` : k.kind === "easement" ? `url(#${uid}-h)` : undefined} />
        <text x={k.x + k.w / 2} y={Y(k.y + k.h / 2)} text-anchor="middle" dominant-baseline="central"
              transform={k.h > k.w * 3 ? `rotate(-90 ${k.x + k.w / 2} ${Y(k.y + k.h / 2)})` : undefined}
              class="klbl" style={`font-size:${f * (k.kind === "easement" ? 0.7 : 0.9)}px`}>{k.label}</text>
      </g>
    ))}
    {wa && (
      <g>
        <rect x={wa[0]} y={Y(wa[1] + wa[3])} width={wa[2]} height={wa[3]} class="wa" style={`stroke-width:${f * 0.2}`} />
        <text x={wa[0] + wa[2] / 2} y={Y(wa[1] + wa[3] / 2)} text-anchor="middle" dominant-baseline="central" class="walbl" style={`font-size:${f}px`}>Working area</text>
        <text x={wa[0] + wa[2] / 2} y={Y(wa[1] + wa[3] / 2) + f * 1.3} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.75}px`}>{wa[2]} × {wa[3]} m, drawn in full above</text>
      </g>
    )}

    {scheme && (
      <g>
        <rect {...box(scheme.driveway)} class="common" />
        <text x={scheme.driveway[0] + scheme.driveway[2] / 2} y={Y(scheme.driveway[1] + scheme.driveway[3] / 2)} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.9}px`}>Common driveway (common property)</text>
        <rect {...box(scheme.parking)} class="common" />
        <text x={scheme.parking[0] + scheme.parking[2] / 2} y={Y(scheme.parking[1] + scheme.parking[3] / 2)} text-anchor="middle" dominant-baseline="central"
              transform={`rotate(-90 ${scheme.parking[0] + scheme.parking[2] / 2} ${Y(scheme.parking[1] + scheme.parking[3] / 2)})`} class="klbl" style={`font-size:${f * 0.8}px`}>Visitor parking</text>
        <rect {...box(scheme.garden)} class="garden" fill={`url(#${uid}-veg)`} />
        <text x={scheme.garden[0] + scheme.garden[2] / 2} y={Y(scheme.garden[1] + 8)} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.8}px`}>Shared garden</text>
        <text x={scheme.garden[0] + scheme.garden[2] / 2} y={Y(scheme.garden[1] + 8) + f * 1.1} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.7}px`}>common property</text>
        <rect {...box(scheme.allocation)} class="alloc" style={`stroke-width:${f * 0.15}`} />
        <text x={scheme.allocation[0] + scheme.allocation[2] / 2} y={Y(scheme.allocation[1] + scheme.allocation[3] / 2)} text-anchor="middle" dominant-baseline="central" class="alloclbl" style={`font-size:${f * 0.75}px`}>SG · 40 m²</text>
        {scheme.lots.map((l) => (
          <g>
            <rect x={l.x} y={Y(l.y + l.h)} width={l.w} height={l.h} class:list={["lot", { mine: l.n === scheme.patel_lot }]} style={`stroke-width:${f * (l.n === scheme.patel_lot ? 0.2 : 0.07)}`} />
            <text x={l.x + l.w / 2} y={Y(l.y + l.h / 2)} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.9}px`}>{l.n === scheme.patel_lot ? "Lot 4" : `${l.n}`}</text>
            {l.n === scheme.patel_lot && <text x={l.x + l.w / 2} y={Y(l.y + l.h / 2) + f * 1.2} text-anchor="middle" dominant-baseline="central" class="klbl" style={`font-size:${f * 0.7}px`}>Patel, 300 m²</text>}
          </g>
        ))}
        <text x={W + f * 0.6} y={Y(scheme.driveway[1] + scheme.driveway[3] / 2)} text-anchor="start" dominant-baseline="central" class="road" style={`font-size:${f * 0.8}px`} transform={`rotate(-90 ${W + f * 0.6} ${Y(scheme.driveway[1] + scheme.driveway[3] / 2)})`}>Street</text>
      </g>
    )}

    {parcel && <text x={W / 2} y={H + f * 1.4} text-anchor="middle" dominant-baseline="central" class="road" style={`font-size:${f * 0.9}px`}>Road</text>}
    <g class="north" transform={`translate(${W + pad - 1.4 * f} ${-pad + 1.8 * f})`}>
      <path d={`M 0 ${-1.3 * f} L ${0.45 * f} ${0.25 * f} L 0 ${-0.1 * f} L ${-0.45 * f} ${0.25 * f} Z`} />
      <text x="0" y={0.95 * f} text-anchor="middle" style={`font-size:${f * 0.7}px`}>N</text>
    </g>
    <g transform={`translate(0 ${H + pad + (parcel ? 0.8 : 0.4) * f})`} class="scale" style={`font-size:${f * 0.65}px`}>
      <rect x="0" y="0" width={scaleStep} height={f * 0.3} class="sb" />
      <rect x={scaleStep} y="0" width={scaleStep} height={f * 0.3} class="sb2" style={`stroke-width:${f * 0.04}`} />
      <text x="0" y={f * 0.95} text-anchor="middle">0</text>
      <text x={2 * scaleStep} y={f * 0.95} text-anchor="middle">{2 * scaleStep} m</text>
    </g>
  </svg>
  <figcaption>{(parcel ?? scheme)!.note}</figcaption>
</figure>

<style>
  .ctxplan {
    margin: 1.5rem 0;
    max-width: 34rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 80vh;
    font-family: var(--at-font-body, system-ui);
  }

  .bound {
    fill: var(--at-bg);
    stroke: var(--at-text);
  }

  .vegdot {
    fill: color-mix(in srgb, var(--at-secondary) 55%, var(--at-bg));
  }

  .hl {
    stroke: var(--at-tertiary);
  }

  .k-drainage {
    fill: color-mix(in srgb, var(--at-primary) 16%, var(--at-bg));
  }

  .k-easement {
    stroke: var(--at-tertiary);
    stroke-width: 0.2;
  }

  .k-retained {
    stroke: none;
  }

  .wa {
    fill: color-mix(in srgb, var(--at-primary) 22%, var(--at-bg));
    stroke: var(--at-primary);
  }

  .common {
    fill: color-mix(in srgb, var(--at-text-muted) 18%, var(--at-bg));
  }

  .garden {
    stroke: var(--at-secondary);
    stroke-width: 0.2;
  }

  .alloc {
    fill: color-mix(in srgb, var(--at-primary) 30%, transparent);
    stroke: var(--at-primary);
    stroke-dasharray: 0.6 0.4;
  }

  .lot {
    fill: var(--at-bg);
    stroke: var(--at-text-muted);
  }

  .lot.mine {
    fill: color-mix(in srgb, var(--at-primary) 22%, var(--at-bg));
    stroke: var(--at-primary);
  }

  .klbl,
  .road {
    fill: var(--at-text-secondary);
    paint-order: stroke;
    stroke: var(--at-bg);
    stroke-width: 0.3;
  }

  .walbl,
  .alloclbl {
    fill: var(--at-text);
    font-weight: 600;
    paint-order: stroke;
    stroke: var(--at-bg);
    stroke-width: 0.3;
  }

  .road {
    font-style: italic;
  }

  .north path {
    fill: var(--at-text);
  }

  .north text,
  .scale text {
    fill: var(--at-text-secondary);
  }

  .sb {
    fill: var(--at-text);
  }

  .sb2 {
    fill: var(--at-bg);
    stroke: var(--at-text);
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--at-text-muted);
    font-size: 0.88rem;
  }
</style>
