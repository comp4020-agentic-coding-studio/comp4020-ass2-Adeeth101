---
/** The programme introduction now opens /method/, so this route stays only as a
 *  short onward page: old links keep working, and nothing competes with
 *  "Programme & method" as a destination. */
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { siteConfig } from "../../site-config";
---

<ContentLayout
  title="The programme has moved"
  description="The Household Resilience Loan Programme, the consultancy and the two phases of the commission now open the Programme and method page."
  {...siteConfig}
>
  <p class="lede">
    The fictional loan programme, Common Ground Engineering, the two phases of the commission and
    the programme's hard constraints now sit at the <strong>start of Programme &amp; method</strong>,
    alongside the reference material every design is measured and costed against.
  </p>

  <ul>
    <li><a href={withBase("/method/#the-scenario")}>The scenario</a> — the programme, the consultancy and your role in it</li>
    <li><a href={withBase("/method/#two-phases")}>The two phases</a> — what the homeowner supplies and what you produce</li>
    <li><a href={withBase("/method/#the-rules")}>The programme's rules</a> — the budget, the energy cap and the investigation allowance</li>
    <li><a href={withBase("/method/")}>Programme &amp; method</a> — the whole page</li>
  </ul>
</ContentLayout>

<style>
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
